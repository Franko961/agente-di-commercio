# Copia questo file in .env e valorizza almeno le variabili OBBLIGATORIE.
# Elenco completo con descrizioni: vedi "Variabili ambiente" nel README alla
# radice del repo. Ogni valore qui sotto è un placeholder, non un default
# reale — i default effettivi (dove esistono) sono in backend/core/config.py.

# --- Obbligatorie: il backend non si avvia senza queste ---
JWT_SECRET=
MONGO_URL=mongodb://localhost:27017
DB_NAME=salesfly_dev

# --- Storage documenti (S3 o compatibile) ---
# Senza queste, l'upload di documenti non funziona (il resto dell'app sì).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=eu-west-1
# Solo per un provider S3-compatibile non-AWS (es. MinIO in locale). Vuoto = AWS S3 reale.
S3_ENDPOINT=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_BASE=
PAYPAL_PLAN_PRO=

# --- Google Calendar (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REAUTH_NOTIFY_COOLDOWN_HOURS=24

# --- AI (assistente) ---
# Senza questa, l'assistente AI risponde con errore — il resto dell'app funziona comunque.
ANTHROPIC_API_KEY=

# --- Altre, tutte opzionali (vuoto = funzionalità disattivata o default in config.py) ---
CORS_ORIGINS=http://localhost:3000
TRIAL_DAYS=14
ORS_API_KEY=
RESEND_API_KEY=
APP_FROM_EMAIL=
ADMIN_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=salesfly-backend
AUTOMATION_ENGINE_INTERVAL_SECONDS=600
AUTOMATION_MAX_ATTEMPTS=5
ADMIN_SECRET=
FRONTEND_URL=http://localhost:3000
TRUSTED_PROXY_HOPS=1
